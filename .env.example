# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=cvapp_user
DB_PASSWORD=your_secure_password_here
DB_NAME=cv_application_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Oracle Cloud Configuration
OCI_NAMESPACE=your_oci_namespace
OCI_BUCKET_NAME=cv-matching-backups
OCI_REGION=eu-frankfurt-1
OCI_TENANCY_ID=ocid1.tenancy.oc1..aaaaaaaxxxxxxx
OCI_USER_ID=ocid1.user.oc1..aaaaaaaxxxxxxx
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00

# Oracle Cloud Private Key (base64 encoded)
# To encode: cat your-private-key.pem | base64 -w 0
OCI_PRIVATE_KEY_BASE64=your_base64_encoded_private_key_here

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@company.com

# VirusTotal API
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Security Configuration
OTP_EXPIRY_MINUTES=10
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Nginx Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443
